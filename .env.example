# Server environment only. Never copy these values into src/, docs/, or voice-config.json.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
# Random private learner access code: at least 12 characters, maximum 256.
VOICE_ACCESS_CODE=
# Separate random signing secret: at least 32 characters.
VOICE_SESSION_SECRET=
# Exact comma-separated origins, no paths or wildcards. HTTP only on loopback.
VOICE_ALLOWED_ORIGINS=https://YOUR-ACCOUNT.github.io,https://YOUR-DEPLOYMENT.vercel.app
